{
    "name": "accounting",
    "productName": "AccountingSystem",
    "version": "1.3.1",
    "description": "Local accounting system for sole proprietor",
    "main": "main.js",
    "build": {
        "win": {
            "target": "portable",
            "artifactName": "AccountingSystem-v${version}-${os}-${arch}.${ext}"
        },
        "mac": {
            "target": [
                {
                    "target": "zip",
                    "arch": [
                        "arm64",
                        "x64"
                    ]
                }
            ],
            "category": "public.app-category.business",
            "artifactName": "AccountingSystem-v${version}-${os}-${arch}.${ext}"
        }
    },
    "scripts": {
        "start": "electron .",
        "pack": "electron-builder --mac --win portable",
        "postinstall": "electron-rebuild"
    },
    "dependencies": {
        "better-sqlite3": "8.7.0",
        "qrcode": "^1.5.4"
    },
    "devDependencies": {
        "electron": "25.9.0",
        "electron-builder": "24.6.4",
        "electron-rebuild": "^3.2.9"
    },
    "author": "Junxiang Wei",
    "license": "MIT"
}
